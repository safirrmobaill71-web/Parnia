<!DOCTYPE html> <html lang="fa" dir="rtl"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>سبزینه | زندگی سالم، انتخاب آگاهانه</title> <style> @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap'); :root { --green: #245c43; --light-green: #e9f3e8; --lime: #c7e8a1; --cream: #faf8f0; --text: #24352b; } * { box-sizing: border-box; margin: 0; padding: 0; } html { scroll-behavior: smooth; } body { font-family: 'Vazirmatn', Tahoma, sans-serif; background: var(--cream); color: var(--text); line-height: 1.9; } a { text-decoration: none; color: inherit; } nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 8%; background: rgba(250,248,240,.95); position: sticky; top: 0; z-index: 10; border-bottom: 1px solid #e7e8dc; } .logo { font-size: 25px; font-weight: 800; color: var(--green); } .logo span { color: #9cbd63; } .nav-links { display: flex; gap: 25px; font-size: 14px; } .nav-links a:hover { color: #78a34f; } .btn { display: inline-block; background: var(--green); color: white; padding: 12px 24px; border-radius: 30px; border: none; cursor: pointer; font-family: inherit; font-size: 14px; transition: .25s; } .btn:hover { background: #367853; transform: translateY(-2px); } .hero { padding: 65px 8% 80px; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 45px; overflow: hidden; } .tag { display: inline-block; background: var(--light-green); color: var(--green); padding: 7px 16px; border-radius: 30px; font-size: 13px; margin-bottom: 20px; } h1 { font-size: clamp(35px, 4.5vw, 59px); line-height: 1.55; font-weight: 800; margin-bottom: 20px; } h1 span { color: #77a64d; } .hero p { color: #68766b; max-width: 470px; margin-bottom: 28px; } .hero-image { position: relative; min-height: 390px; border-radius: 45% 45% 25px 25px; background: linear-gradient(0deg, rgba(25,65,41,.08), transparent), url('https://images.unsplash.com/photo-1512621776951-a57141f2eefd?auto=format&fit=crop&w=1100&q=85') center/cover; box-shadow: 0 25px 60px #365b321c; } .floating { position: absolute; bottom: 25px; right: -18px; background: white; padding: 15px 20px; border-radius: 18px; box-shadow: 0 10px 35px #00000012; font-size: 14px; } .floating strong { display: block; color: var(--green); font-size: 19px; } .stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 15px; padding: 25px 8%; background: #eff4e8; text-align: center; } .stat strong { font-size: 24px; color: var(--green); display: block; } .stat span { font-size: 13px; color: #69776a; } section { padding: 75px 8%; } .section-heading { text-align: center; margin-bottom: 38px; } .section-heading h2 { font-size: 31px; margin-bottom: 8px; } .section-heading p { color: #788078; } .cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; } .card { background: white; border-radius: 22px; overflow: hidden; border: 1px solid #edf0e8; transition: .3s; } .card:hover { transform: translateY(-7px); box-shadow: 0 16px 40px #29472a12; } .card img { width: 100%; height: 205px; object-fit: cover; display: block; } .card-content { padding: 22px; } .card-content small { color: #779e55; font-weight: 700; } .card-content h3 { margin: 8px 0; font-size: 19px; } .card-content p { color: #788078; font-size: 14px; } .more { display: inline-block; color: var(--green); margin-top: 14px; font-weight: 700; cursor: pointer; } .meal-section { background: var(--light-green); border-radius: 35px; margin: 0 5%; padding: 55px 5%;
  }
.meal-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-top: 30px; } .meal { padding: 25px; background: white; border-radius: 20px; } .meal .emoji { font-size: 30px; } .meal h3 { margin: 8px 0; } .meal p { color: #748075; font-size: 14px; } .newsletter { text-align: center; background: var(--green); color: white; border-radius: 30px; padding: 55px 20px; } .newsletter p { color: #d5e5d7; margin: 10px 0 25px; } .newsletter form { display: flex; justify-content: center; gap: 10px; max-width: 480px; margin: auto; } .newsletter input { min-width: 0; flex: 1; padding: 13px 17px; border: none; border-radius: 25px; font: inherit; } .newsletter button { background: var(--lime); color: var(--green); } #message { margin-top: 15px; font-size: 14px; } footer { padding: 30px 8%; display: flex; justify-content: space-between; gap: 15px; flex-wrap: wrap; color: #7a8479; font-size: 13px; } @media(max-width: 760px) { .nav-links { display: none; } nav { padding: 17px 5%; } .hero { grid-template-columns: 1fr; padding: 45px 6%; gap: 30px; } .hero-image { min-height: 310px; margin-right: 12px; } .stats { padding: 22px 4%; } .stat strong { font-size: 20px; } section { padding: 55px 6%; } .cards, .meal-grid { grid-template-columns: 1fr; } .meal-section { margin: 0 3%; } .newsletter form { flex-direction: column; } .newsletter input, .newsletter button { width: 100%; } } </style> </head> <body> <nav> <a href="#"
